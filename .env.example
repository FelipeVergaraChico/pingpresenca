# Copie para .env e substitua os dois segredos. Nunca versione .env.
# Gere cada segredo separadamente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_DB=pingpresenca
POSTGRES_USER=pingpresenca
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
# Porta de loopback do PostgreSQL para desenvolvimento sem Docker da API.
POSTGRES_PORT=54329

# Usados na primeira inicialização. Fuso é persistido; mudar o ambiente depois
# não reinterpreta a instalação: a API rejeita divergências até ajuste explícito.
INSTALLATION_NAME=Minha instituição
INSTALLATION_TIME_ZONE=America/Sao_Paulo
# Apenas bootstrap. Após criar o owner, remova o valor e recrie a API.
BOOTSTRAP_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO

# Compose publica frontend/API no mesmo origin; backend fica na rede interna.
WEB_PORT=8080
# Opcional, somente durante build Docker em redes restritas:
# NPM_REGISTRY=https://registry.npmmirror.com
PUBLIC_ORIGIN=http://localhost:8080
# true é obrigatório para HTTPS; false é aceito somente com origin de loopback.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

# Para desenvolvimento sem Docker da API:
# npm run dev usa Vite em http://localhost:5173. Ajuste PUBLIC_ORIGIN acima.
# DATABASE_URL opcional prevalece sobre POSTGRES_*; credenciais na URL precisam
# de percent-encoding. Não é necessário no Compose nem no fluxo local padrão.
# DATABASE_URL=postgresql://usuario:senha@localhost:54329/pingpresenca
API_HOST=127.0.0.1
API_PORT=3000
POSTGRES_HOST=127.0.0.1

# E1 oferece convites manuais pela interface administrativa. SMTP fica na E5.
