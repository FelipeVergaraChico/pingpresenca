# Template para instalação DESCARTÁVEL. Não substitui .env de uma instituição real.
# Copie para .env.demo (ignorado pelo Git) e gere uma senha forte própria.
# As portas abaixo são exemplos: verificar disponibilidade antes de implantar.
POSTGRES_DB=pingpresenca_demo_public
POSTGRES_USER=pingpresenca_demo
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
POSTGRES_PORT=54339
WEB_PORT=8087
INSTALLATION_NAME=Ping Presença — demonstração pública
INSTALLATION_TIME_ZONE=America/Sao_Paulo
PUBLIC_DEMO=true
BOOTSTRAP_SECRET=
PUBLIC_ORIGIN=https://demopingpresenca.online
COOKIE_SECURE=true
NPM_REGISTRY=https://registry.npmmirror.com
