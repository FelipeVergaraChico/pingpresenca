{
  "name": "@ping-presenca/backend",
  "version": "0.4.0-e3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "recover:owner": "tsx src/identity/recover-owner-cli.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "test": "tsx --test test/unit.test.ts test/*.unit.test.ts",
    "test:pilot": "tsx --test test/e3.integration.test.ts",
    "test:integration": "tsx --test test/integration.test.ts && tsx --test test/e1.integration.test.ts && tsx --test test/e2.integration.test.ts && tsx --test test/e3.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  }
}
